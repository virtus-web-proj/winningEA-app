PORT=4000
# REQUIRED in production: long random string
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RECAPTCHA_SECRET_KEY=your-secret-key
JWT_SECRET=replace-with-a-unique-random-string-at-least-32-characters
# Origin of the React app (CORS). Not needed when the server serves client/dist.
CLIENT_ORIGIN=http://localhost:5173
# Contact-form emails (optional; messages are always stored in the DB)
CONTACT_TO=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Winning EA <no-reply@example.com>"
# Bank-transfer details shown on the buy page
BANK_NAME=
BANK_BRANCH=
BANK_TYPE=
BANK_NUMBER=
BANK_HOLDER=
# Google reCAPTCHA v2 secret key. Required in production for registration/contact.
RECAPTCHA_SECRET_KEY=
